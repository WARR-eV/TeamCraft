{
  "id": "teamcraft",
  "name": "TeamCraft",
  "version": "0.1.0",
  "description": "TeamCraft item of the design, a check before checking it in to TeamCraft, linking a design to a TeamCraft item, and – through a folder shared with the TeamCraft desktop app – its live state and requests to check out, check in or open it.",
  "capabilities": ["commands@0.2"],
  "runtime": {
    "module": "plugin.wasm",
    "entries": [
      {
        "name": "status",
        "effect": "read",
        "input_schema": {"type": "object", "properties": {}},
        "slots": [{"kind": "ribbon", "name": "TeamCraft status"}]
      },
      {
        "name": "check",
        "effect": "read",
        "input_schema": {"type": "object", "properties": {}},
        "slots": [{"kind": "ribbon", "name": "Check for TeamCraft"}]
      },
      {
        "name": "check-assembly",
        "effect": "edit",
        "input_schema": {"type": "object", "properties": {}},
        "slots": [{"kind": "ribbon", "name": "Check assembly for TeamCraft"}]
      },
      {
        "name": "link",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "required": ["item_number", "revision"],
          "properties": {
            "item_number": {"type": "string", "title": "Item number", "maxLength": 256},
            "revision": {"type": "string", "title": "Revision", "maxLength": 256},
            "name": {"type": "string", "title": "Item name", "maxLength": 256},
            "server": {"type": "string", "title": "TeamCraft server (https://…)", "maxLength": 256}
          }
        },
        "slots": [{"kind": "ribbon", "name": "Link to TeamCraft item"}]
      },
      {
        "name": "unlink",
        "effect": "edit",
        "input_schema": {"type": "object", "properties": {}},
        "slots": [{"kind": "ribbon", "name": "Unlink from TeamCraft"}]
      },
      {
        "name": "live",
        "effect": "read",
        "input_schema": {"type": "object", "properties": {}},
        "slots": [{"kind": "ribbon", "name": "TeamCraft live status"}]
      },
      {
        "name": "check-out",
        "effect": "edit",
        "input_schema": {"type": "object", "properties": {}},
        "slots": [{"kind": "ribbon", "name": "Check out in TeamCraft"}]
      },
      {
        "name": "check-in",
        "effect": "edit",
        "input_schema": {"type": "object", "properties": {}},
        "slots": [{"kind": "ribbon", "name": "Check in with TeamCraft"}]
      },
      {
        "name": "open",
        "effect": "edit",
        "input_schema": {"type": "object", "properties": {}},
        "slots": [{"kind": "ribbon", "name": "Open in TeamCraft"}]
      }
    ],
    "commands": [
      "document.inspect",
      "document.metadata.set",
      "document.metadata.remove",
      "assembly.bom",
      "component.links"
    ],
    "limits": {"fuel": 50000000, "memory_mib": 64, "deadline_ms": 10000},
    "permissions": {
      "files": [{"name": "teamcraft", "read": true, "write": true}],
      "clock": true
    }
  }
}
